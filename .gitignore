# Large data files — use Git LFS or external storage
#data/hydrological/*.csv
#data/meteorological/*.csv
#data/geomorphological/catchment_descriptors.csv
#!data/hydrological/README.md
#!data/meteorological/README.md
#!data/geomorphological/README.md

# Raw ERA5-Land NetCDF files (never commit)
*.nc
*.grib

# Model checkpoint files (large — store externally)
*.pt
*.pth
*.ckpt
results/model_outputs/

# Pickle files of model outputs (large — store externally or via LFS)
# Comment out the line below if you want to commit pre-computed .p files
*.p

# Compiled metrics tables (regenerated by notebooks)
# Comment out to version-control pre-computed results
# results/tables/*.csv

# Figures (regenerated by notebooks)
results/figures/

# Temporary files
*.tmp
*.log
*.bak
